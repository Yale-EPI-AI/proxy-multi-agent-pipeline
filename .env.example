ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COMTRADE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEE_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Specify output directory
OUTPUTS_DIR=/path/to/outputs_dir

# ── Local Inference ─────────────────────────────────────────────────────────────
# Set to true to use a local inference server
USE_LOCAL_INFERENCE=true

# If LOCAL_ENGINE_TYPE is set (managed mode), this URL's port is used as a starting hint for discovery.
# If LOCAL_ENGINE_TYPE is empty (unmanaged mode), this is the exact URL the client will connect to.
LOCAL_INFERENCE_URL=http://localhost:8000/v1
LOCAL_MODEL_NAME=openai/gpt-oss-120b

# Engine configuration (vllm or sglang) — used to start the engine automatically.
# Set to empty or "none" to use an already-running server at LOCAL_INFERENCE_URL.
LOCAL_ENGINE_TYPE=vllm
# Space-separated arguments for the engine
LOCAL_ENGINE_ARGS=--tool-call-parser openai --enable-auto-tool-choice --enable-chunked-prefill --enable-prefix-caching --async-scheduling

# Optional: Granular local model names for each stage
# (Useful if you want to use different models for different tasks)
# LOCAL_RESEARCH_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# LOCAL_DISCOVERY_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# LOCAL_PARSING_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# LOCAL_VERIFICATION_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# LOCAL_VALIDATION_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
