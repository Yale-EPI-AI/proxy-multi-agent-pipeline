    <edge source="proxy:OEB-H11" target="indicator:OEB">
      <data key="d23">proxy_for</data>
      <data key="d24">{}</data>
      <data key="d25">OEB-H11</data>
      <data key="d26">nonlinear</data>
      <data key="d27">threshold</data>
      <data key="d28">r = 0.2-0.3 (unclear sign)</data>
      <data key="d29">Deforestation reduces biogenic VOC emissions but typically increases anthropogenic activity (roads, agriculture). Net effect on ozone depends on whether loss of biogenic emissions outweighs increased human activity.</data>
      <data key="d30" />
      <data key="d31" />
      <data key="d32" />
      <data key="d33" />
      <data key="d34" />
      <data key="d35" />
      <data key="d36" />
      <data key="d37" />
      <data key="d38">[]</data>
    </edge>
    <edge source="proxy:OEB-H11" target="source:world_resources_institute">
      <data key="d23">measured_by</data>
      <data key="d24">{}</data>
    </edge>
    <edge source="proxy:OEB-H12" target="indicator:OEB">
      <data key="d23">proxy_for</data>
      <data key="d24">{}</data>
      <data key="d25">OEB-H12</data>
      <data key="d26">positive</data>
      <data key="d27">linear</data>
      <data key="d28">r = 0.4-0.6</data>
      <data key="d29">Photochemical ozone formation accelerates at higher temperatures. Heat extremes coincide with high solar radiation and suppressed vertical mixing, creating ideal conditions for ozone accumulation.</data>
      <data key="d30" />
      <data key="d31" />
      <data key="d32" />
      <data key="d33" />
      <data key="d34" />
      <data key="d35" />
      <data key="d36" />
      <data key="d37" />
      <data key="d38">[]</data>
    </edge>
