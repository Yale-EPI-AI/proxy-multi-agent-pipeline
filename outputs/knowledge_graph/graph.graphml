      <data key="d23">inferred_candidate</data>
      <data key="d24">{}</data>
      <data key="d44">cross_indicator_transfer</data>
      <data key="d45">0.8</data>
      <data key="d46">Proxy OEB-H03 confirmed/partially confirmed for sibling indicator; untested for OEC</data>
      <data key="d47">["OEB-H03"]</data>
